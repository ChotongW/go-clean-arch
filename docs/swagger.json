{
    "swagger": "2.0",
    "info": {
        "description": "This is a sample server for Go Clean Architecture.",
        "title": "Go Clean Arch API",
        "contact": {},
        "version": "1.0"
    },
    "host": "localhost:9090",
    "basePath": "/",
    "paths": {
        "/pdf/compress/{file_name}": {
            "post": {
                "description": "Compresses the PDF file specified by the file name parameter.",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "PDFs"
                ],
                "summary": "Compress a PDF file",
                "parameters": [
                    {
                        "type": "string",
                        "description": "The name of the PDF file to compress",
                        "name": "file_name",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "201": {
                        "description": "Compressed PDF file details",
                        "schema": {
                            "$ref": "#/definitions/domain.Pdf"
                        }
                    },
                    "404": {
                        "description": "File not found",
                        "schema": {
                            "$ref": "#/definitions/rest.ResponseError"
                        }
                    },
                    "500": {
                        "description": "Internal server error",
                        "schema": {
                            "$ref": "#/definitions/rest.ResponseError"
                        }
                    }
                }
            }
        },
        "/pdf/edit": {
            "put": {
                "description": "Request body for editing a PDF file (rotate, add image, add SVG, etc.)",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "PDFs"
                ],
                "parameters": [
                    {
                        "description": "PDF Edit Request",
                        "name": "body",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/rest.PdfEditRequest"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Edited PDF",
                        "schema": {
                            "$ref": "#/definitions/domain.Pdf"
                        }
                    },
                    "400": {
                        "description": "Invalid request body or missing parameters",
                        "schema": {
                            "$ref": "#/definitions/rest.ResponseError"
                        }
                    },
                    "500": {
                        "description": "Internal server error",
                        "schema": {
                            "$ref": "#/definitions/rest.ResponseError"
                        }
                    }
                }
            }
        },
        "/pdf/fetch": {
            "get": {
                "description": "Fetches a list of PDFs based on the provided query parameter `num`",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "PDFs"
                ],
                "summary": "Fetch a list of PDFs",
                "parameters": [
                    {
                        "type": "integer",
                        "default": 10,
                        "description": "Number of PDFs to fetch",
                        "name": "num",
                        "in": "query"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "List of PDFs",
                        "schema": {
                            "type": "array",
                            "items": {
                                "$ref": "#/definitions/domain.Pdf"
                            }
                        }
                    },
                    "400": {
                        "description": "Bad request",
                        "schema": {
                            "$ref": "#/definitions/rest.ResponseError"
                        }
                    },
                    "500": {
                        "description": "Internal server error",
                        "schema": {
                            "$ref": "#/definitions/rest.ResponseError"
                        }
                    }
                }
            }
        },
        "/pdf/merge": {
            "post": {
                "description": "Merge the provided list of PDF files into a single file",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "PDFs"
                ],
                "summary": "Merge PDF files",
                "parameters": [
                    {
                        "description": "List of file names to be merged",
                        "name": "request",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/rest.MergeRequest"
                        }
                    }
                ],
                "responses": {
                    "201": {
                        "description": "The merged PDF file",
                        "schema": {
                            "$ref": "#/definitions/domain.Pdf"
                        }
                    },
                    "422": {
                        "description": "Unprocessable entity error details",
                        "schema": {
                            "type": "string"
                        }
                    },
                    "500": {
                        "description": "Internal server error",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        }
                    }
                }
            }
        },
        "/pdf/split/{file_name}": {
            "post": {
                "description": "Splits the given PDF file into multiple files based on its content",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "PDFs"
                ],
                "summary": "Split a PDF file",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Name of the PDF file to split",
                        "name": "file_name",
                        "in": "path",
                        "required": true
                    },
                    {
                        "type": "integer",
                        "default": 1,
                        "description": "Number of pages per split",
                        "name": "pages_per_split",
                        "in": "query"
                    }
                ],
                "responses": {
                    "201": {
                        "description": "Array of split PDF files",
                        "schema": {
                            "type": "array",
                            "items": {
                                "$ref": "#/definitions/domain.Pdf"
                            }
                        }
                    },
                    "400": {
                        "description": "Bad request",
                        "schema": {
                            "$ref": "#/definitions/rest.ResponseError"
                        }
                    },
                    "404": {
                        "description": "File not found",
                        "schema": {
                            "$ref": "#/definitions/rest.ResponseError"
                        }
                    },
                    "500": {
                        "description": "Internal server error",
                        "schema": {
                            "$ref": "#/definitions/rest.ResponseError"
                        }
                    }
                }
            }
        },
        "/pdf/upload": {
            "post": {
                "description": "Upload one or more PDF files and save them to the server",
                "consumes": [
                    "multipart/form-data"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "PDFs"
                ],
                "summary": "Upload PDF files",
                "parameters": [
                    {
                        "type": "file",
                        "description": "PDF files to be uploaded",
                        "name": "pdfs",
                        "in": "formData",
                        "required": true
                    }
                ],
                "responses": {
                    "201": {
                        "description": "List of uploaded PDFs",
                        "schema": {
                            "type": "array",
                            "items": {
                                "$ref": "#/definitions/domain.Pdf"
                            }
                        }
                    },
                    "400": {
                        "description": "Invalid request, error details",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        }
                    },
                    "500": {
                        "description": "Internal server error",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        }
                    }
                }
            }
        }
    },
    "definitions": {
        "domain.Pdf": {
            "type": "object",
            "required": [
                "file_name",
                "file_path",
                "file_size"
            ],
            "properties": {
                "created_at": {
                    "type": "string"
                },
                "file_name": {
                    "type": "string"
                },
                "file_path": {
                    "type": "string"
                },
                "file_size": {
                    "type": "integer"
                },
                "id": {
                    "type": "integer"
                },
                "updated_at": {
                    "type": "string"
                }
            }
        },
        "rest.MergeRequest": {
            "type": "object",
            "properties": {
                "fileNames": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                }
            }
        },
        "rest.PdfEditRequest": {
            "type": "object",
            "properties": {
                "file_name": {
                    "type": "string"
                },
                "operation": {
                    "type": "string"
                },
                "params": {
                    "type": "object",
                    "additionalProperties": true
                }
            }
        },
        "rest.ResponseError": {
            "type": "object",
            "properties": {
                "message": {
                    "type": "string"
                }
            }
        }
    }
}